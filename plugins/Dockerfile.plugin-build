# syntax=docker/dockerfile:1.7
#
# Reproducible in-Docker build for a Higress Proxy-Wasm plugin.
#
# The builder stage pins the Go toolchain required by the current Higress Wasm
# SDK. The final stage contains only the OCI artifact contract: /plugin.wasm in
# a scratch image.
#
# Build context: the plugin directory.
FROM golang:1.24.1 AS build

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN GOOS=wasip1 GOARCH=wasm go build -buildmode=c-shared -o /out/plugin.wasm .

FROM scratch

COPY --chmod=0444 --from=build /out/plugin.wasm /plugin.wasm

LABEL org.opencontainers.image.title="Higress Wasm plugin"
LABEL org.opencontainers.image.description="Proxy-Wasm plugin distributed as an OCI artifact"
