# Higress Coolify Reference Architecture
#
# Local template. Coolify deployments use managed environment variables and
# should not commit a .env file.

# --- Runtime image ---------------------------------------------------------
# Immutable reference is mandatory for production. Resolve the digest with:
#   ./scripts/pin-image.sh <registry>/higress/all-in-one:<version>
#
# HIGRESS_IMAGE=<registry>/higress/all-in-one:<version>@sha256:<digest>
HIGRESS_IMAGE=
HIGRESS_PLATFORM=linux/amd64

# --- Control plane ---------------------------------------------------------
HIGRESS_CONSOLE_ADMIN_USER=admin

# Generate: openssl rand -base64 36
HIGRESS_CONSOLE_ADMIN_PASSWORD=

# Generate: openssl rand -base64 48. Rotate deliberately: existing API tokens
# are invalidated.
HIGRESS_CONSOLE_OPENAPI_JWT_SECRET=

TZ=UTC
JAVA_OPTS="-Xms256m -Xmx512m"

# --- State -----------------------------------------------------------------
# Stable volume identity. Changing this value after initialization creates a new
# empty volume and requires a data migration.
HIGRESS_VOLUME_NAME=higress-data

# --- Resource envelope -----------------------------------------------------
HIGRESS_CPU_LIMIT=2.0
HIGRESS_MEM_LIMIT=2g
HIGRESS_CPU_RESERVATION=0.25
HIGRESS_MEM_RESERVATION=512m

# --- Coolify routing contract ----------------------------------------------
# Managed in Coolify; kept here as documentation.
# SERVICE_FQDN_HIGRESS_8080=api.example.com
# SERVICE_FQDN_HIGRESS_8001=console.example.com
